meta {
  name: 02_Buscar salas proximas sem conflito
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/salas/disponiveis/proximas?cep=01001000&data={{dataAmanha}}&horaInicio=16:00&horaFim=18:00
  body: none
  auth: inherit
}

params:query {
  cep: 01001000
  data: {{dataAmanha}}
  horaInicio: 16:00
  horaFim: 18:00
}

vars:pre-request {
  baseUrl: http://localhost:8081
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("retorna array", function() {
    expect(res.getBody()).to.be.an("array");
  });

  test("salas adjacentes a reserva anterior ainda aparecem (sem conflito)", function() {
    expect(res.getBody().length).to.be.at.least(1);
  });
}

docs {
  Horario 16:00-18:00 e adjacente ao slot 14:00-16:00 (T4).
  A regra de overlap usa < / >, entao adjacencia nao e conflito.
  Ambas as salas ativas devem aparecer no resultado.
}
