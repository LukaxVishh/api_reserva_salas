meta {
  name: 03_Buscar salas proximas com CEP invalido
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/salas/disponiveis/proximas?cep=abc&data={{dataAmanha}}&horaInicio=14:00&horaFim=16:00
  body: none
  auth: inherit
}

params:query {
  cep: abc
  data: {{dataAmanha}}
  horaInicio: 14:00
  horaFim: 16:00
}

vars:pre-request {
  baseUrl: http://localhost:8081
}

tests {
  test("CEP invalido -> 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("body tem campo erro", function() {
    expect(res.getBody()).to.have.property("erro");
  });

  test("mensagem menciona CEP", function() {
    expect(res.getBody().erro).to.match(/cep|n.meros/i);
  });
}
