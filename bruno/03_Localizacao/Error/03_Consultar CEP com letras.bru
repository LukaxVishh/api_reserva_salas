meta {
  name: 03_Consultar CEP com letras
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/localizacao/cep/abc
  body: none
  auth: inherit
}

vars:pre-request {
  baseUrl: http://localhost:8081
}

tests {
  test("CEP com letras -> 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("body tem campo erro", function() {
    expect(res.getBody()).to.have.property("erro");
  });

  test("mensagem menciona formato do CEP", function() {
    expect(res.getBody().erro).to.match(/cep|n.meros|8/i);
  });
}
