meta {
  name: 01_Consultar CEP valido
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/localizacao/cep/01001000
  body: none
  auth: inherit
}

vars:pre-request {
  baseUrl: http://localhost:8081
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("retornou cep correto", function() {
    expect(res.getBody().cep).to.equal("01001000");
  });

  test("retornou logradouro", function() {
    expect(res.getBody()).to.have.property("logradouro");
  });

  test("cidade e Sao Paulo", function() {
    expect(res.getBody().cidade).to.match(/s.o paulo/i);
  });

  test("uf e SP", function() {
    expect(res.getBody().uf).to.equal("SP");
  });
}
