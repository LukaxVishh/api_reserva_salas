meta {
  name: 02_Gerar evento busca salas proximas
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/salas/disponiveis/proximas?cep=01001000&data={{dataAmanha}}&horaInicio=16:00&horaFim=18:00
  body: none
  auth: inherit
}

params:query {
  cep: 01001000
  data: {{dataAmanha}}
  horaInicio: 16:00
  horaFim: 18:00
}

vars:pre-request {
  baseUrl: http://localhost:8081
}

tests {
  test("busca de salas proximas -> 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("retorna array (evento BuscaSalasProximasEvent foi publicado)", function() {
    expect(res.getBody()).to.be.an("array");
  });
}

docs {
  Buscar salas proximas dispara BuscaSalasProximasEvent via EventPublisher.
  O evento e consumido e persistido em eventos_sistema.
  Este teste verifica que o endpoint responde 200;
  o evento RabbitMQ acontece de forma assincrona em background.

  Para confirmar a auditoria: conectar ao MySQL e executar:
    SELECT * FROM eventos_sistema ORDER BY id DESC LIMIT 5;
}
